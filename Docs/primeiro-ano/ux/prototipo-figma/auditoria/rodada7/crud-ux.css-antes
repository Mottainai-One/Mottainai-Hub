/* Refinamentos compartilhados dos CRUDs; contratos e dados permanecem no Spring. */
body[data-pagina] { --azul-administrativo:#0b1f3a; --crud-navy:var(--azul-administrativo); }
body[data-pagina] .header, body[data-pagina] .sidebar, body[data-pagina] .sidebar-logo { background:var(--azul-administrativo); }
body[data-pagina] .sidebar { padding-top:0; }
body[data-pagina] .sidebar-logo { height:var(--header-altura); min-height:var(--header-altura); justify-content:center; padding:10px 0; }
body[data-pagina] .sidebar-logo img { width:194px; max-width:100%; max-height:54px; object-position:center; }
body[data-pagina] .perfil-administrativo { position:relative; margin-left:auto; }
body[data-pagina] .perfil-trigger { color:#fff; padding:6px; border-radius:6px; }
body[data-pagina] .perfil-trigger:hover { background:#ffffff12; }
body[data-pagina] .perfil-trigger:focus-visible { outline:2px solid #dd7b2d; outline-offset:2px; }
body[data-pagina] .perfil-popup { position:absolute; top:calc(100% + 10px); right:0; width:300px; max-width:calc(100vw - 36px); padding:20px; background:#fff; color:#102a43; border:1px solid #d8dfe7; border-radius:10px; box-shadow:0 8px 24px #0003; z-index:30; }
body[data-pagina] .perfil-popup[hidden] { display:none; }
body[data-pagina] .perfil-popup p { margin-top:8px; overflow-wrap:anywhere; }
body[data-pagina] .perfil-popup form { margin-top:14px; border-top:1px solid #e2e3df; padding-top:12px; }
body[data-pagina] .perfil-sair { color:#102a43; font-weight:700; padding:6px 0; }
body[data-pagina] .perfil-sair:hover { color:#a34e0d; }
body[data-pagina] .btn-pesquisar { background:var(--laranja-titulo); color:#102a43; border:1px solid var(--laranja-titulo); transition:filter .2s,transform .2s; }
body[data-pagina] .btn-pesquisar:hover { background:var(--laranja-titulo); color:#102a43; filter:brightness(1.08); transform:translateY(-2px); }
body[data-pagina] .busca-status { font-size:12px; color:#526274; margin:-10px 0 18px; }
body[data-pagina] .tabela tbody tr[hidden] { display:none; }
body[data-pagina] .modal-overlay[data-administration] .modal { width:min(100%,620px); }
@media(min-width:651px) {
 body[data-pagina] .sidebar { position:sticky; top:0; height:100dvh; overflow-y:auto; align-self:start; z-index:21; }
 body[data-pagina] .sidebar-nav { flex:1 0 auto; padding-top:16px; justify-content:center; }
}
@media(max-width:650px) { body[data-pagina] .header { padding:12px 18px; } body[data-pagina] .header-nome { display:none; } body[data-pagina] .perfil-popup { width:270px; } }
