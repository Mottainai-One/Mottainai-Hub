

:root {
   --azul-primario: #102A43;   
    --azul-claro: #426B8C;     
    --creme: #FDEBDD;            
    --branco: #FBFCFD;           
    --texto-escuro: #132736;
    --texto-corpo: #424842;
   --laranja: #DD7B2D;  
   --laranja-claro: #F8B983;  
    --cinza: #444444;
    --borda-card: #e2e3df;
    --azul-clarissimo: #F5F7FA;


    --fonte: 'DM Sans', sans-serif;
    --radius-botao: 4px;
    --radius-card: 20px;
    --sombra-card: 0 4px 12px rgba(0, 0, 0, 0.08);
}

* {
    font-family: "DM Sans";
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--fonte);
    background-color: var(--azul-clarissimo);
    color: var(--texto-escuro);
    line-height: 1.5;
     margin: 0;
    padding: 0;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

h1, h2, h3 {
    font-weight: 700;
    line-height: 1.2;
}

header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 40px;
    margin: 0px;
    background-color: var(--branco);

    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;

}

nav{
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: large;
}

nav div{
    padding: 30px;
}


#logo{
    width: 200px;
}

h1.hero-h1{
    color: var(--laranja);
    line-height: normal;
    margin: 0px 30px;
    font-size: 70px;
    font-weight: 600;
    letter-spacing: 3px;
}

.div-h1{
    background-size: cover;
    background-position: center;
    background-color: var(--azul-primario);
    height: 670px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
}

.p-hero{
    margin: 30px;
    line-height: 50px;
    color:#fefefe;
    max-width: 750px;
    overflow-wrap: break-word;
    word-wrap: break-word;
    font-size: x-large;
}

#significado{
    background-image: url("../assets/img/sobre-nos-hero-1.png");
}
#proposta{
    background-image: url("../assets/img/sobre-nos-hero-2.png");
}
#nosso-ideal{
    background-image: url("../assets/img/sobre-nos-hero-3.png");
}
#nosso-produto{
    background-image: url("../assets/img/sobre-nos-hero-4.png");
}

ul{
    list-style: none;
}


#nossa-equipe{
    background-color:var(--azul-primario);
    color: var(--branco);
    border-radius: 30px;
    padding: 5px 5px;
    margin: 50px 400px;
    text-align: center;
    font-weight: 600;
    font-size: xx-large;

}

/* Parte copiada do gusta*/

footer {
    padding: 60px 8% 30px;
    background-color: var(--branco);
}

.footer-topo {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 32px;
    margin-bottom: 40px;
}

.footer-logo img {
    height: 28px;
    width: auto;
}

.footer-logo p {
    margin-top: 12px;
    font-size: 15px;
    color: var(--texto-corpo);
    max-width: 200px;
}

.footer-coluna h5 {
    font-size: 17px;
    margin-bottom: 16px;
}

.footer-coluna ul li {
    font-size: 15px;
    color: var(--texto-corpo);
    margin-bottom: 12px;
}

footer hr {
    border: none;
    border-top: 1px solid var(--borda-card);
    margin-bottom: 20px;
}

.footer-base p {
    font-size: 14px;
    color: var(--texto-corpo);
    text-align: center;
}

.contato-button{
    background-color: var(--azul-primario);
    color: var(--branco);
    border-radius: 5px;
    padding: 10px 15px;
    font-weight: 500;
}

#pag-selecionada{
    font-weight: 700;

}  




/* hover */

.btn:hover {
    transform: translateY(-2px);
    opacity: 0.9;
    transform: scale(1.05);
}



/* carrossel do hero */
.car-btn{
    display: grid;
    place-items: center;
    cursor: pointer;
    background-color: var(--branco);
    color: var(--azul-primario);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 16px;
    box-shadow: var(--sombra-card);
    user-select: none;
    transition: transform .2s;
}

.car-btn:hover{
    transform: scale(1.1);
}

.hero-carrossel{
    --tempo: 7s;
    position: relative;
    overflow: hidden;
}

.hero-radio{
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
}

.hero-track{
    display: flex;
    width: 400%;
    animation: hero-auto calc(var(--tempo) * 4) ease-in-out infinite;
    transition: transform .6s ease;
}

.hero-carrossel .slide{
    position: relative;
    flex: 0 0 25%;
}

.hero-carrossel .car-btn{
    position: absolute;
    bottom: 17px;
}

.hero-carrossel .prev{ left: 30px; }
.hero-carrossel .next{ right: 30px; }

.hero-carrossel .p-hero{
    margin-bottom: 80px;
}



@keyframes hero-auto{
    0%, 20%   { transform: translateX(0); }
    25%, 45%  { transform: translateX(-25%); }
    50%, 70%  { transform: translateX(-50%); }
    75%, 95%  { transform: translateX(-75%); }
    100%      { transform: translateX(0); }
}

/* depois do primeiro clique o autoplay para */
.hero-radio:checked ~ .hero-track{ animation: none; }
#hero-1:checked ~ .hero-track{ transform: translateX(0); }
#hero-2:checked ~ .hero-track{ transform: translateX(-25%); }
#hero-3:checked ~ .hero-track{ transform: translateX(-50%); }
#hero-4:checked ~ .hero-track{ transform: translateX(-75%); }

.car-dots{
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: 30px;
    display: flex;
    gap: 10px;
}

.car-dots label{
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--branco);
    cursor: pointer;
    animation: dot-ativo calc(var(--tempo) * 4) infinite;
}

.car-dots label:nth-child(2){ animation-delay: calc(var(--tempo) * 1); }
.car-dots label:nth-child(3){ animation-delay: calc(var(--tempo) * 2); }
.car-dots label:nth-child(4){ animation-delay: calc(var(--tempo) * 3); }

@keyframes dot-ativo{
    0%, 24.9% { background: var(--laranja); border-color: var(--laranja); transform: scale(1.2); }
    25%, 100% { background: transparent; border-color: var(--branco); transform: scale(1); }
}

.hero-radio:checked ~ .car-dots label{ animation: none; }

#hero-1:checked ~ .car-dots label:nth-child(1),
#hero-2:checked ~ .car-dots label:nth-child(2),
#hero-3:checked ~ .car-dots label:nth-child(3),
#hero-4:checked ~ .car-dots label:nth-child(4){
    background: var(--laranja);
    border-color: var(--laranja);
    transform: scale(1.2);
}

#hero-1:focus-visible ~ .car-dots label:nth-child(1),
#hero-2:focus-visible ~ .car-dots label:nth-child(2),
#hero-3:focus-visible ~ .car-dots label:nth-child(3),
#hero-4:focus-visible ~ .car-dots label:nth-child(4){
    outline: 3px solid var(--laranja);
    outline-offset: 3px;
}

.bloco-ano{
    zoom: 1.15;
    max-width: 930px;
    margin: 0 auto 60px;
    padding: 0;                   
    position: relative;
}

.titulo-ano{
    display: inline-block;
    padding: 12px 36px;
    margin-bottom: 24px;
    margin-left: -100vw;          
    padding-left: calc(100vw + 36px);
    border-radius: 0 12px 12px 0;  
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}

#primeiro-ano{
    background-color: var(--azul-claro);
    color: var(--branco);
}

#segundo-ano{
    background-color: var(--laranja-claro);
    color: var(--cinza);
}

.carrossel-wrap{
    display: flex;
    align-items: center;
    gap: 12px;
}

.carrossel{
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 18px;
    padding: 10px 4px 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--azul-claro) transparent;
}


.cartoes{
    flex: 0 0 200px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.cartoes img{
    order: 0;
    width: 200px;
    height: 266px;
    object-fit: cover;
    border-radius: 8px;
    background-color: var(--azul-clarissimo);
    transition: transform .25s;
}

.cartoes:hover img{
    transform: translateY(-4px);
}

.cartoes strong{
    order: 2;                
    font-size: 21px;
    font-weight: 700;
    margin-top: 0;
    color: var(--texto-escuro);   
}

.cartoes span{
    order: 1;               
    font-size: 12px;
    line-height: 1.2;
    margin-top: 8px;
    color: var(--texto-escuro);
    max-width: 200px;
    overflow-wrap: break-word;
}


/* aqui embaixo */

#nossa-equipe{ margin: 50px auto; max-width: 400px; }

@media (max-width: 768px){
    header{ padding: 10px 16px; }
    nav div{ padding: 10px; }
    #logo{ width: 120px; }
    h1.hero-h1{ font-size: 40px; margin: 0 20px; }
    .p-hero{ line-height: 1.6; font-size: large; margin: 20px; }
    .hero-carrossel .p-hero{ margin-bottom: 70px; }
    .carrossel-wrap{ padding: 0 !important; }
    .div-h1{ height: 560px; }
}
@media (prefers-reduced-motion: reduce){
    .hero-track, .car-dots label{ animation: none; transition: none; }
    .carrossel{ scroll-behavior: auto; }
}


@supports selector(::scroll-button(*)){
    .carrossel-wrap{ padding: 0 56px; }
    .bloco-ano{ anchor-scope: --equipe; }
    .carrossel{ anchor-name: --equipe; }

    .carrossel::scroll-button(*){
        position: fixed;
        position-anchor: --equipe;
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 50%;
        background: var(--branco);
        color: var(--azul-primario);
        box-shadow: var(--sombra-card);
        font-size: 18px;
        cursor: pointer;
    }

    .carrossel::scroll-button(left){
        content: "\276E" / "Anterior";
        position-area: left center;
        margin-right: 8px;
    }

    .carrossel::scroll-button(right){
        content: "\276F" / "Próximo";
        position-area: right center;
        margin-left: 8px;
    }

    .carrossel::scroll-button(*):disabled{
        opacity: .35;
        cursor: default;
    }
}


/* ===== Landing / sobré nós. 91:8980 — carrosséis nativos da V7 preservados ===== */
.hero-carrossel { height:700px; min-height:0; margin:0; }
.hero-carrossel .div-h1 { min-height:700px; padding:145px 53px 80px; }
.hero-carrossel .hero-h1 { font-size:68px; line-height:1.15; margin:0 0 25px; letter-spacing:2px; }
.hero-carrossel .p-hero { width:660px; max-width:65%; font-size:26px; line-height:1.7; margin:0; }
.hero-carrossel .car-btn { width:55px; height:55px; font-size:25px; }
.hero-carrossel .car-dots { bottom:35px; }
main > section:last-child { padding:70px 0 170px; background-image:url('../assets/img/home-linhas-cta.png'); background-position:right center; background-size:100% auto; background-repeat:no-repeat; }
#nossa-equipe { max-width:860px; margin:0 auto 70px; padding:5px 30px; border-radius:50px; background:#102a43; font-size:46px; line-height:1.35; text-align:center; color:#f5f7fa; }
.titulo-ano { width:235px; margin:0 0 80px; padding:12px 55px; font-size:35px; line-height:1.25; border-radius:0 15px 15px 0; }
.bloco-ano { max-width:1300px; margin:0 auto 95px; padding:0 35px; }
.carrossel-wrap { padding:0; }
.carrossel { display:flex; gap:38px; padding:5px 0 20px; overflow-x:auto; scroll-snap-type:x mandatory; }
.cartoes { flex:0 0 calc((100% - 114px) / 4); min-width:0; scroll-snap-align:start; }
.cartoes img { width:100%; height:365px; display:block; object-fit:cover; border-radius:15px; }
.cartoes .span-cartoes { display:block; margin-top:7px; font-size:15px; line-height:1.4; }
.cartoes strong { display:block; font-size:27px; line-height:1.3; }
@media(max-width:1100px) { .hero-carrossel,.hero-carrossel .div-h1 { height:590px; min-height:590px; } .hero-carrossel .div-h1 { padding-top:125px; } .hero-carrossel .hero-h1 { font-size:58px; } .hero-carrossel .p-hero { font-size:22px; max-width:80%; } #nossa-equipe { max-width:75%; font-size:38px; } .carrossel { gap:25px; } .cartoes { flex-basis:calc((100% - 50px) / 3); } .cartoes img { height:330px; } .cartoes strong { font-size:22px; } }
@media(max-width:767px) { .hero-carrossel,.hero-carrossel .div-h1 { height:560px; min-height:560px; } .hero-carrossel .div-h1 { padding:95px 25px 90px; } .hero-carrossel .hero-h1 { font-size:43px; } .hero-carrossel .p-hero { max-width:100%; width:auto; font-size:20px; } .hero-carrossel .car-btn { width:40px; height:40px; } #nossa-equipe { max-width:90%; margin-bottom:50px; font-size:32px; } .titulo-ano { margin-bottom:40px; width:180px; padding:12px 30px; font-size:29px; } .bloco-ano { padding:0 24px; margin-bottom:65px; } .carrossel { gap:20px; } .cartoes { flex-basis:80%; } .cartoes img { height:365px; } .cartoes strong { font-size:25px; } main > section:last-child { padding-bottom:80px; } }
/* Auto e manual usam os mesmos radios e a transição V7 de .6s ease. */
.hero-carrossel[data-enhanced] .hero-track { animation:none; transition:transform .6s ease; }
.hero-carrossel[data-enhanced] .car-dots button { animation:none; }
.car-btn { border:0; font:inherit; cursor:pointer; }
.car-dots button { display:block; width:12px; height:12px; padding:0; border-radius:50%; border:2px solid white; background:transparent; cursor:pointer; }
.car-dots button[aria-pressed="true"] { background:var(--laranja); border-color:var(--laranja); transform:scale(1.2); }
.car-dots button:focus-visible,.car-btn:focus-visible { outline:3px solid #dd7b2d; outline-offset:5px; }
.titulo-ano { margin-left:0; width:235px; height:68px; padding:12px 55px; box-sizing:border-box; display:flex; align-items:center; white-space:nowrap; }
main > section:last-child { background-image:url('../assets/img/sobre-nos-linhas-inferiores.png'),url('../assets/img/sobre-nos-linhas-superiores.png'); background-size:100% auto,100% auto; background-position:left top 269px,left top -793px; }
@media(max-width:767px) { .titulo-ano { width:180px; height:61px; padding:12px 30px; } main > section:last-child { background-size:900px auto,900px auto; background-position:left -200px top 400px,right -160px top -200px; } }
@media(prefers-reduced-motion:reduce) { .hero-carrossel[data-enhanced] .hero-track { transition:none; } }
/* O zoom herdado ampliava fotos e espaços além das dimensões do frame. */
.bloco-ano { zoom:1; }
.bloco-ano:last-child { margin-bottom:0; }
/* Rodada 5: elevação discreta do texto nos quatro slides; controles/track inalterados. */
.hero-carrossel .div-h1 { padding-bottom:104px; }
@media(max-width:767px) { .hero-carrossel .div-h1 { padding-bottom:106px; } }
